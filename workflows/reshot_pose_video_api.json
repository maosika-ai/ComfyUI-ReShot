{
  "1": {
    "class_type": "LoadVideo",
    "_meta": {
      "title": "Load Video (reference clip)"
    },
    "inputs": {
      "file": "reference.mp4"
    }
  },
  "2": {
    "class_type": "ReShotPoseVideo",
    "_meta": {
      "title": "ReShot Pose Video"
    },
